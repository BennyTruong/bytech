@page "/not-found"
@layout MainLayout

<PageTitle>@T.NotFoundHeading – Bytech</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<section class="section plain-page">
    <div class="container">
        <h1>@T.NotFoundHeading</h1>
        <p>@T.NotFoundText</p>
        <a class="button button-primary" href="@T.BasePath">@T.NotFoundCta</a>
    </div>
</section>

@code {
    [CascadingParameter] public required SiteText T { get; set; }
}
