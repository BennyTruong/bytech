@inherits LayoutComponentBase
@inject NavigationManager Nav

<CascadingValue Value="text" IsFixed="true">
    <SiteHeader />

    <main>
        @Body
    </main>

    <SiteFooter />
</CascadingValue>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private SiteText text = SiteText.Sv;

    protected override void OnInitialized() => text = SiteText.For(Nav);
}
