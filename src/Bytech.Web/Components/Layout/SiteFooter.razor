<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <img class="footer-logo" src="@Assets["img/bytech-logo-white.png"]" alt="Bytech" width="199" height="61" loading="lazy" />
                <p class="footer-blurb">@T.FooterBlurb</p>
                <a class="icon-button" href="@SiteText.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                    <Icon Name="linkedin" />
                </a>
            </div>

            <div>
                <h2>@T.NavExpertise</h2>
                <ul>
                    @foreach (var area in T.Areas)
                    {
                        <li><a href="@T.Anchor(area.Id)">@area.Title</a></li>
                    }
                </ul>
            </div>

            <div>
                <h2>@T.NavContact</h2>
                <ul>
                    <li>
                        <a class="with-icon" href="@SiteText.LinkedInUrl" target="_blank" rel="noopener noreferrer">
                            <Icon Name="linkedin" /> LinkedIn
                        </a>
                    </li>
                    <li class="with-icon"><Icon Name="pin" /> @T.FooterLocation</li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© @DateTime.Now.Year Bytech</p>
            <a class="footer-lang" href="@T.OtherLangPath" hreflang="@(T.IsEnglish ? "sv" : "en")" data-lang-toggle data-enhance-nav="false">
                @(T.IsEnglish ? "Svenska" : "English")
            </a>
        </div>
    </div>
</footer>

@code {
    [CascadingParameter] public required SiteText T { get; set; }
}
